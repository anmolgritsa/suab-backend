# Supabase backend — environment variables
# Copy this file to .env (which should be git-ignored) and fill in your actual values.
# Find these in your Supabase Dashboard: Project Settings -> API

# Supabase project URL
SUPABASE_URL=https://supabase.co

# Public (anon) key — safe for browsers/mobile, protected by Row Level Security (RLS)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — bypasses RLS. SERVER-SIDE ONLY; never expose to clients.
# Uncomment if needed for admin tasks:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
